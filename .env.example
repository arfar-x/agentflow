# agentflow -- copy to .env, fill in real values, chmod 600.
# See docs/CONFIGURATION.md for what every variable does and what breaks
# if it's wrong.

### ---- LibreChat / port ----
PORT=3080
# Both images are the STABLE (tagged-release) channel, not the -dev image
# that tracks the main branch on every merge -- ghcr.io/danny-avila/librechat
# vs. .../librechat-dev. Check for newer tags at
# https://github.com/danny-avila/LibreChat/pkgs/container/librechat and
# https://github.com/danny-avila/LibreChat/pkgs/container/librechat-rag-api-dev-lite
# before upgrading -- see docs/OPERATIONS.md "Upgrades".
LIBRECHAT_IMAGE_TAG=v0.8.7
RAG_API_IMAGE_TAG=v0.9.0

### ---- Secrets (generate with scripts/generate-secrets.sh -- do not hand-edit) ----
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

### ---- Mongo (auth is ON in this compose file, unlike LibreChat's upstream default) ----
MONGO_ROOT_USERNAME=agentflow_root
MONGO_ROOT_PASSWORD=
# App-level user LibreChat itself authenticates as; create it once Mongo is
# up (docs/OPERATIONS.md) then reference it here.
MONGO_APP_USERNAME=librechat
MONGO_APP_PASSWORD=
# MONGO_URI is built from the two variables above directly in
# docker-compose.yml (not here) -- .env's own variable interpolation is a
# single top-down pass, so building it here is order-sensitive in a way
# that silently breaks if a value gets pasted in below this line instead
# of edited in place above.

### ---- Meilisearch ----
MEILI_MASTER_KEY=

### ---- SearXNG (web search) ----
# In-Docker address LibreChat's api reaches SearXNG at (backend compose
# network, no published port). Must match webSearch.allowedAddresses in
# config/librechat.yaml. SearXNG is free/open -- no API key.
SEARXNG_INSTANCE_URL=http://searxng:8080

### ---- pgvector (RAG) ----
POSTGRES_DB=agentflow_rag
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=
# Must be an embeddings model your vLLM/embedding endpoint actually serves.
RAG_EMBEDDINGS_PROVIDER=openai
RAG_EMBEDDINGS_MODEL=

### ---- Knowledge base (kb) ----
# Its own Postgres instance (service `kb-db`), separate from LibreChat's
# `vectordb` on purpose -- see docs/spec/knowledge-base.md. Create the schema
# and the read-only role with `make kb-init` after the stack is up.
KB_POSTGRES_DB=agentflow_kb
KB_POSTGRES_USER=kb
KB_POSTGRES_PASSWORD=
# The least-privilege role the query path connects as: it may read the catalog
# and append to the gap log, nothing else. Never give the query path the owner
# credential above.
KB_READER_PASSWORD=

# --- what sync reads, and how it describes it ---
# Sync needs a READ-ONLY SERVICE ACCOUNT: it has to see a space to catalog it.
# This is not the per-user credential an agent uses to read a page later -- that
# check still happens at the source, as the user. Unset KB_* values fall back to
# the CONFLUENCE_*/JIRA_* ones above.
# KB_CONFLUENCE_BASE_URL=
# KB_CONFLUENCE_USERNAME=
# KB_CONFLUENCE_PASSWORD=
# KB_CONFLUENCE_PAT=
# KB_JIRA_BASE_URL=
# KB_JIRA_USERNAME=
# KB_JIRA_PASSWORD=
# KB_JIRA_PAT=
#
# The summarizer: any OpenAI-compatible endpoint (your vLLM one works). Unset
# means sync still runs and catalogs documents under their real titles,
# undescribed -- degraded, not blocked. The languages are what make a question
# in one find a document written in the other.
# KB_SUMMARIZER_URL=${VLLM_BASE_URL}
# KB_SUMMARIZER_MODEL=
# KB_SUMMARIZER_API_KEY=${VLLM_API_KEY}
KB_SUMMARY_LANGUAGES=en

### ---- LLM endpoint (vLLM, OpenAI-compatible) ----
# This deployment's endpoint advertises id "claude-sonnet-4-6" for a
# different underlying model -- config/librechat.yaml treats that as an
# opaque label and declares context length explicitly rather than trusting
# the name. See docs/CONFIGURATION.md.
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_API_KEY=
# Optional: pin VLLM_BASE_URL's host to a fixed IP inside the api + rag_api
# containers (wired via extra_hosts in docker-compose.yml). Use it when that
# host doesn't resolve from your box the way the model endpoint needs. Both
# must be non-empty (an empty value breaks `docker compose config`); if you
# don't need it, leave the placeholders -- they're harmless.
MODEL_HOSTNAME=your-model-host
MODEL_HOST_IP=192.0.2.1

### ---- MCP: agent-skills ----
# Space-separated toolset names, each needing skills/<name>/requirements.txt
# installed into the mcp-agent-skills image.
MCP_TOOLSETS="jira confluence"

# Jira -- required for every jira_* MCP tool (skills/jira/SKILL.md).
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
# optional -- true skips the confirm step before writes; leave unset/false
# in production so LibreChat's own toolApproval is the only gate.
JIRA_AUTO_CONFIRM_WRITES=false
# optional -- only used by jira_triage
JIRA_DEFAULT_PROJECT=
# optional -- only required the first time create_issue/edit_issue sets an assignee
JIRA_DEPLOYMENT_TYPE=

# Confluence -- required for every confluence_* MCP tool
# (skills/confluence/SKILL.md).
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
# optional -- true skips the confirm step before writes; leave unset/false
# in production so LibreChat's own toolApproval is the only gate.
CONFLUENCE_AUTO_CONFIRM_WRITES=false
# optional -- used by my_pages/get_page_by_title when no --space_key is given
CONFLUENCE_DEFAULT_SPACE=
# required -- cloud or server. Confluence's REST API is mounted at a
# different path per deployment (Cloud: /wiki/rest/api, Server/DC: /rest/api)
CONFLUENCE_DEPLOYMENT_TYPE=

### ---- Auth: local (default) ----
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false

# First/admin account -- created automatically by scripts/bootstrap.sh
# (docs/OPERATIONS.md "First run"), not through the UI, since
# ALLOW_REGISTRATION is false. Use a generic address you control
# (a shared team inbox, or a .local/.internal placeholder that's never
# actually sent mail), not a real person's personal email -- this is a
# service account for the deployment, not tied to one individual.
ADMIN_EMAIL=admin@agentflow.local
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

### ---- Admin panel (github.com/ClickHouse/librechat-admin-panel) ----
# Separate service, bundled below in docker-compose.yml. Needs LibreChat
# v0.8.5+. Admin access is checked by `api` itself (role: 'ADMIN' in
# Mongo, or the access:admin grant) -- the panel can't grant itself
# privileges. The first user registered in this (unscoped, single-tenant)
# deployment is auto-admin, so ADMIN_EMAIL above already qualifies.
# Min 32 chars. Generate with: openssl rand -hex 32
ADMIN_PANEL_SESSION_SECRET=
# Host port for the admin panel UI; defaults to 3000 if unset.
ADMIN_PANEL_PORT=3000

### ---- Auth: Keycloak OIDC (optional -- see docs/KEYCLOAK.md) ----
# Uncomment this whole block and set ALLOW_EMAIL_LOGIN=false above to
# switch. No rebuild needed -- restart the api service.
# ALLOW_SOCIAL_LOGIN=true
# ALLOW_SOCIAL_REGISTRATION=true
# OPENID_ISSUER=https://<keycloak-host>/realms/<realm>
# OPENID_CLIENT_ID=librechat
# OPENID_CLIENT_SECRET=
# OPENID_CALLBACK_URL=/oauth/openid/callback
# OPENID_SCOPE="openid profile email"
# OPENID_SESSION_SECRET=
# OPENID_REQUIRED_ROLE=librechat-user
# OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
# OPENID_REQUIRED_ROLE_TOKEN_KIND=access
# OPENID_USE_END_SESSION_ENDPOINT=true

# ---- Agent import (`make agent-import`) -- all optional -----------------------
# Apply to every agent import on THIS deployment, so the files under agents/ can
# stay exactly as committed instead of being edited to fit each environment. A
# value given on the command line (`make agent-import MODEL_NAME=...`) wins over
# these. See docs/AGENT_SYNC.md.
#
# Own every imported agent as this account (must exist). Unset: the agent's
# current owner, else ADMIN_EMAIL above, else the oldest admin.
# OWNER_EMAIL=
# Use this provider/model for every imported agent instead of the ones in the
# files. Unset: the file's, falling back to this instance's default when the
# file's don't exist here (the import lists those to review in the UI).
# MODEL_PROVIDER=
# MODEL_NAME=
