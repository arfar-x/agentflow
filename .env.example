# agentflow -- copy to .env, fill in real values, chmod 600.
# This is Dify's own docker/.env.example, trimmed to the services this
# stack actually runs (postgresql + pgvector, no TLS/certbot, no
# multi-vector-store menu) and with every development-default secret
# ("difyai123456" and friends) replaced by a blank filled in by
# scripts/generate-secrets.sh -- never hand-write a secret here.
# See docs/CONFIGURATION.md for what breaks if something's wrong.
#
# Anything NOT in this file still has a real default inside Dify's own
# image -- this file only lists what agentflow's setup actually needs to
# override. See docker/.env.example in langgenius/dify (tag 1.17.1) for
# the complete list of every other tunable.

### ---- Core service URLs ----
# Leave blank for a same-origin, path-based deployment behind the bundled
# nginx (the default here) -- Dify infers these from the request when empty.
# Fill them in only once this is reachable at a real hostname.
CONSOLE_API_URL=
SERVER_CONSOLE_API_URL=http://api:5001
CONSOLE_WEB_URL=
SERVICE_API_URL=
APP_API_URL=
APP_WEB_URL=
FILES_URL=
INTERNAL_FILES_URL=
NEXT_PUBLIC_SOCKET_URL=ws://localhost

### ---- Secrets (generate with scripts/generate-secrets.sh -- do not hand-edit) ----
# Encrypts every credential Dify stores (model provider keys, tool
# credentials, etc.) -- rotating this on a live deployment makes existing
# stored credentials permanently unreadable, same rule as every other
# stack in this repo's history. See docs/OPERATIONS.md "Secrets".
SECRET_KEY=
# Optional gate in front of first-run /console/api/setup -- leave blank
# unless this deployment's port is reachable by more than you before you
# finish creating the admin account. See docs/CONFIGURATION.md "Auth".
INIT_PASSWORD=

### ---- Database (Dify's own app state -- users, apps, conversations) ----
DB_TYPE=postgresql
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

### ---- Redis (cache + Celery broker/backend) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Dify does NOT derive this from REDIS_PASSWORD above -- it's a separate,
# fully-spelled-out connection string that embeds the same password a
# second time. scripts/generate-secrets.sh prints both together, already
# in sync; if you ever change REDIS_PASSWORD by hand, update this to match.
CELERY_BROKER_URL=redis://:CHANGE_ME_SAME_AS_REDIS_PASSWORD@redis:6379/1
CELERY_BACKEND=redis

### ---- Vector store (RAG embeddings for knowledge bases / file uploads) ----
# pgvector: self-hosted, no external account needed, consistent with the
# rest of this repo's history. A SEPARATE Postgres instance from DB_* above
# -- this is Dify's own tested default shape (two Postgres containers, one
# per role), not something agentflow merged; see docs/OPERATIONS.md.
VECTOR_STORE=pgvector
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=
PGVECTOR_DATABASE=dify
# The pgvector CONTAINER's own provisioning vars -- PGVECTOR_POSTGRES_PASSWORD
# must equal PGVECTOR_PASSWORD above; they configure the same password from
# two different sides (the container's own init vs. the app's connection string).
PGVECTOR_PGUSER=postgres
PGVECTOR_POSTGRES_PASSWORD=
PGVECTOR_POSTGRES_DB=dify
PGVECTOR_PGDATA=/var/lib/postgresql/data/pgdata

### ---- Plugin daemon (runs installed model-provider/tool plugins) ----
DB_PLUGIN_DATABASE=dify_plugin
PLUGIN_DAEMON_KEY=
# Must equal INNER_API_KEY_FOR_PLUGIN, which docker-compose.yml sets on the
# api/worker services from this same variable -- two names for one value.
PLUGIN_DIFY_INNER_API_KEY=

### ---- Sandbox (Python code-execution tool) ----
# Must match each other -- one configures the sandbox service itself, the
# other is how api/worker authenticate to it.
SANDBOX_API_KEY=
CODE_EXECUTION_API_KEY=

### ---- Dify Agent backend (Agent Soul / agent_v2 runtime) ----
# Bearer token for the Agent backend's own control-plane API.
DIFY_AGENT_API_TOKEN=
# Derives the JWE encryption key for Agent Stub bearer tokens -- security-sensitive.
DIFY_AGENT_SERVER_SECRET_KEY=

### ---- SSRF proxy allowlist ----
# Every outbound tool/MCP/HTTP-Request-node call from api/worker routes
# through the bundled `ssrf_proxy` (squid), which denies private-network
# destinations by default -- exactly the private range `mcp-agent-skills`
# (and `searxng`, if you wire it into a tool) resolve to on the backend
# compose network. This declarative allowlist is what makes those two
# reachable at all; see AGENTS.md "Architecture" for how this was found
# (nothing under docker/ ships this by default).
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=mcp-agent-skills,searxng

### ---- Nginx (the only published port) ----
EXPOSE_NGINX_PORT=80
NGINX_SERVER_NAME=_

### ---- Compose profiles ----
# Selects db_postgres (DB_TYPE) and pgvector (VECTOR_STORE) as the two
# Postgres-family services that actually start; add `,collaboration` to
# also run api_websocket for the live workflow-co-editing feature (off by
# default -- unrelated to normal chat/workflow use).
COMPOSE_PROFILES=${VECTOR_STORE:-pgvector},${DB_TYPE:-postgresql}

### ---- MCP: agent-skills ----
# Space-separated toolset names, each needing skills/<name>/requirements.txt
# installed into the mcp-agent-skills image.
MCP_TOOLSETS="jira confluence"

# Jira/Confluence credentials are a SINGLE SHARED identity for this
# deployment (not per-user) -- mcp-agent-skills' own process environment,
# used for every jira_*/confluence_* call regardless of which Dify
# workspace member is chatting. See docs/CONFIGURATION.md "Per-user vs.
# shared credentials" for why, and what upgrading to per-user would need.
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
# optional -- true skips agent-skills' own confirm step before writes;
# leave false so a write always needs an explicit --confirm from the model.
JIRA_AUTO_CONFIRM_WRITES=false
JIRA_DEFAULT_PROJECT=
# optional -- only required the first time create_issue/edit_issue sets an assignee
JIRA_DEPLOYMENT_TYPE=

CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
CONFLUENCE_AUTO_CONFIRM_WRITES=false
CONFLUENCE_DEFAULT_SPACE=
# required -- cloud or server. Confluence's REST API is mounted at a
# different path per deployment (Cloud: /wiki/rest/api, Server/DC: /rest/api)
CONFLUENCE_DEPLOYMENT_TYPE=

### ---- Admin account (created once via scripts/bootstrap.sh -> /console/api/setup) ----
# Use a generic address you control (a shared team inbox, or a
# .local/.internal placeholder that's never actually sent mail), not a
# real person's personal email -- this is a service account for the
# deployment, not tied to one individual.
DIFY_ADMIN_EMAIL=admin@agentflow.local
DIFY_ADMIN_NAME=Admin
DIFY_ADMIN_PASSWORD=

### ---- LLM endpoint (vLLM, OpenAI-compatible) ----
# Not env-driven in Dify -- model providers are plugins, configured once
# via the console API by scripts/bootstrap.sh (or by hand in Studio if the
# OpenAI-API-compatible plugin isn't installed yet). Kept here only so one
# file holds every value this deployment needs to fill in.
# See docs/CONFIGURATION.md "LLM endpoint" for the manual plugin-install
# step this can't safely automate (no verified marketplace identifier).
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_API_KEY=
# The model id your vLLM endpoint actually serves, e.g. "claude-sonnet-4-6"
# even if that's a label over a different underlying model -- see
# docs/CONFIGURATION.md for the advertised-model-id caveat.
VLLM_MODEL_NAME=
