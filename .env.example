# agentflow -- copy to .env, fill in real values, chmod 600.
# See docs/CONFIGURATION.md for what every variable does and what breaks
# if it's wrong.

### ---- Open WebUI / port ----
PORT=3080
# ghcr.io/open-webui/open-webui -- pin a real published tag before
# production. `main` moves under you without warning; use a dated/semver
# release tag. Check https://github.com/open-webui/open-webui/pkgs/container/open-webui
# before upgrading -- see docs/OPERATIONS.md "Upgrades".
OPEN_WEBUI_IMAGE_TAG=v0.11.1

### ---- Secrets (generate with scripts/generate-secrets.sh -- do not hand-edit) ----
# Signs session tokens AND encrypts every credential Open WebUI stores
# (including config/tools/agent_skills.py's per-user Jira/Confluence
# Valves) -- Open WebUI's single equivalent of LibreChat's
# CREDS_KEY+CREDS_IV+JWT_SECRET+JWT_REFRESH_SECRET combined.
WEBUI_SECRET_KEY=

### ---- Postgres (Open WebUI's app database AND its pgvector RAG store) ----
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=

### ---- LLM endpoint (vLLM, OpenAI-compatible) ----
# This deployment's endpoint advertises id "claude-sonnet-4-6" for a
# different underlying model -- Open WebUI treats that as an opaque
# label; see docs/CONFIGURATION.md for the one-time Admin Settings step
# that sets its display name explicitly rather than trusting the id.
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_API_KEY=

### ---- MCP: agent-skills ----
# Space-separated toolset names, each needing skills/<name>/requirements.txt
# installed into the mcp-agent-skills image.
MCP_TOOLSETS="jira confluence"

# Jira -- required for every jira_* MCP tool (skills/jira/SKILL.md).
# Left blank here on purpose: every Jira tool call's credential comes
# per-user instead, via config/tools/agent_skills.py's own Valves (each
# user fills these in once, in Open WebUI, under Workspace -> Tools ->
# the wrench icon on "Agent Skills (Jira & Confluence)"). Set these only
# if you want a shared fallback identity instead of per-user.
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
# optional -- true skips the confirm step before writes; leave unset/false
# in production so config/tools/agent_skills.py's own confirmation card
# is the only front-end gate.
JIRA_AUTO_CONFIRM_WRITES=false
# optional -- only used by jira_triage/my_work/sprint/kanban_status as a
# fallback when a user hasn't set their own JIRA_DEFAULT_PROJECT Valve
JIRA_DEFAULT_PROJECT=
# optional -- only required the first time create_issue/edit_issue sets an assignee
JIRA_DEPLOYMENT_TYPE=

# Confluence -- required for every confluence_* MCP tool
# (skills/confluence/SKILL.md).
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_PASSWORD=
# optional -- true skips the confirm step before writes; leave unset/false
# in production so config/tools/agent_skills.py's own confirmation card
# is the only front-end gate.
CONFLUENCE_AUTO_CONFIRM_WRITES=false
# optional -- fallback when a user hasn't set their own
# CONFLUENCE_DEFAULT_SPACE Valve
CONFLUENCE_DEFAULT_SPACE=
# required -- cloud or server. Confluence's REST API is mounted at a
# different path per deployment (Cloud: /wiki/rest/api, Server/DC: /rest/api)
CONFLUENCE_DEPLOYMENT_TYPE=

### ---- Auth: local (default) ----
# Open WebUI has no separate ALLOW_EMAIL_LOGIN switch -- WEBUI_AUTH=true
# (default, don't unset it) is local email/password auth; ENABLE_SIGNUP
# below controls open self-registration specifically.
ENABLE_SIGNUP=false

# First/admin account -- created automatically by open-webui itself on
# startup if no user exists yet (its own headless-bootstrap mechanism,
# docs/OPERATIONS.md "First run"), not through the UI, since ENABLE_SIGNUP
# is false. Use a generic address you control (a shared team inbox, or a
# .local/.internal placeholder that's never actually sent mail), not a
# real person's personal email -- this is a service account for the
# deployment, not tied to one individual. Open WebUI has no separate
# username field; it identifies accounts by email.
WEBUI_ADMIN_EMAIL=admin@agentflow.local
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_PASSWORD=

### ---- Auth: Keycloak OIDC (optional -- see docs/KEYCLOAK.md) ----
# Uncomment this whole block and set ENABLE_OAUTH_SIGNUP=true above to
# switch. No rebuild needed -- restart the open-webui service.
# ENABLE_OAUTH_SIGNUP=true
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
# OAUTH_PROVIDER_NAME=Keycloak
# OAUTH_CLIENT_ID=open-webui
# OAUTH_CLIENT_SECRET=
# OPENID_PROVIDER_URL=https://<keycloak-host>/realms/<realm>/.well-known/openid-configuration
# OAUTH_SCOPES="openid email profile"
# OAUTH_ROLES_CLAIM=roles
# OAUTH_ALLOWED_ROLES=open-webui-user
# OAUTH_ADMIN_ROLES=open-webui-admin
# ENABLE_OAUTH_ROLE_MANAGEMENT=true
