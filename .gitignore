.env
backups/
*.env.bak
# real secret_key generated from searxng/settings.yml.example -- see
# scripts/bootstrap.sh and docs/OPERATIONS.md
searxng/settings.yml
# editor swap/backup files -- .env is edited often enough that these
# are worth excluding explicitly rather than trusting every editor's
# own global ignore config
.*.swp
.*.swo
*~

# Local state and config of AI coding agents -- per-developer, not part of
# this repo. (Project instructions live in AGENTS.md, which every tool reads;
# CLAUDE.md is a symlink to it.)
.kilo/
.claude/
.cursor/
.codex/
.gemini/
.opencode/
.roo/
.cline/
.windsurf/
.continue/

# Python build/test artifacts from kb/ (see kb/README.md for the venv setup --
# the virtualenv and the editable install's metadata are per-developer, like
# the AI-agent directories above)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
